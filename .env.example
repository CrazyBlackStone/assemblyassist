# Copy to .env.local for local development (gitignored). For GitHub Pages, add these as
# repository secrets (Settings -> Secrets and variables -> Actions); deploy.yml passes them in.
# Anything here is built into the public site's JavaScript: put a spending limit on the keys,
# or run a proxy (VITE_AI_PROXY_URL) that adds the key server-side instead.

VITE_OPENROUTER_API_KEY=
# Optional: OpenAI key for speech-to-text with gpt-4o-mini-transcribe (otherwise OpenRouter audio, then the browser)
VITE_OPENAI_API_KEY=
# Optional: server that forwards /openrouter/* and /openai/* with the keys attached (e.g. on EC2)
VITE_AI_PROXY_URL=
# Optional pairing relay, e.g. coturn on EC2: [{"urls":"turn:host:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS=
VITE_PEER_HOST=
